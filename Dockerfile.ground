# Dockerfile.ground — ACAS Ground Station
# =========================================
# Full environment. No resource constraints.
# Runs dashboard, API, training tools.
# NEVER goes to space.

FROM python:3.11-slim

WORKDIR /acas

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
    && rm -rf /var/lib/apt/lists/*

# Full requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy everything
COPY . .

ENV PYTHONPATH="/acas"
ENV PYTHONUNBUFFERED=1

EXPOSE 8501
EXPOSE 8000